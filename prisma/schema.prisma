generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Sprint {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  title                String
  description          String?
  priceInPaise         Int
  originalPriceInPaise Int
  startDate            DateTime
  endDate              DateTime
  seatsTotal           Int      @default(30)
  seatsFilled          Int      @default(0)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  enrollments SprintEnrollment[]

  @@index([slug])
  @@index([isActive])
}

model SprintEnrollment {
  id                 String           @id @default(cuid())
  sprintId           String
  userId             String
  email              String
  name               String
  phone              String?
  razorpayOrderId    String           @unique
  razorpayPaymentId  String?          @unique
  amountInPaise      Int
  status             EnrollmentStatus @default(PENDING)
  lmsEnrolledAt      DateTime?
  lmsEnrollmentError String?
  enrolledAt         DateTime         @default(now())
  paidAt             DateTime?
  refundedAt         DateTime?
  notes              String?

  sprint Sprint @relation(fields: [sprintId], references: [id])

  @@index([userId])
  @@index([sprintId])
  @@index([status])
  @@index([razorpayOrderId])
}

model BootcampEnrollment {
  id                 String           @id @default(cuid())
  userId             String
  email              String
  name               String
  phone              String?
  plan               BootcampPlan
  razorpayOrderId    String           @unique
  razorpayPaymentId  String?          @unique
  amountInPaise      Int
  status             EnrollmentStatus @default(PENDING)
  lmsEnrolledAt      DateTime?
  lmsEnrollmentError String?
  enrolledAt         DateTime         @default(now())
  paidAt             DateTime?
  notes              String?

  @@index([userId])
  @@index([status])
  @@index([razorpayOrderId])
}

model WaitlistEntry {
  id          String   @id @default(cuid())
  cohort      String
  name        String
  email       String
  phone       String?
  motivation  String
  consentedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Qualifying answers (null on signups from before they were asked).
  role       String?
  experience String?
  payer      String?
  /// ICP fit 0–100 and its tier (A/B/C), from src/lib/lead-score.ts.
  score      Int?
  tier       String?

  /// First-touch attribution: UTM tags, referring site, and landing page.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  referrer    String?
  landingPath String?

  @@unique([cohort, email])
  @@index([cohort])
  @@index([cohort, tier])
}

/// A learner's own testimonial. Identity fields are copied from the Google or
/// LinkedIn account they signed in with, never typed by them, so the public
/// card can say which provider vouched for the name and photo.
model Testimonial {
  id          String            @id @default(cuid())
  /// One testimonial per Clerk user; resubmitting edits it and re-queues review.
  clerkUserId String            @unique
  status      TestimonialStatus @default(PENDING)
  featured    Boolean           @default(false)

  /// From the verified OAuth account ("google" or "linkedin").
  provider    String
  name        String
  avatarUrl   String?
  /// Verified email: used for the paid-learner match and to contact them. Never shown.
  email       String

  /// Typed by the learner, so shown as self-reported.
  headline    String
  linkedinUrl String?
  quote       String

  mediaKind        TestimonialMedia @default(NONE)
  mediaUrl         String?
  mediaPathname    String?
  mediaContentType String?
  transcript       String?

  /// Set when the email or Clerk id matches a PAID enrolment at submit time.
  verifiedLearner Boolean @default(false)
  /// Comma-separated sprint titles the match found, e.g. "Sprint 1, Sprint 2".
  learnerSprints  String?

  consentVersion String
  consentedAt    DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  reviewedAt     DateTime?

  @@index([status, featured])
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TestimonialMedia {
  NONE
  AUDIO
  VIDEO
}

enum EnrollmentStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum BootcampPlan {
  earlyBird
  regular
}
